+const RE = /^\s*(?:(\d+)\s*d)?\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?\s*(?:(\d+)\s*s)?\s*$/i;
+
 module.exports = function parseDuration(text) {
-  throw new Error("not implemented");
+  if (typeof text !== "string") throw new TypeError("duration must be a string");
+  const m = RE.exec(text);
+  if (!m || m.slice(1).every((g) => g === undefined)) {
+    throw new TypeError(`invalid duration: ${text}`);
+  }
+  const [d, h, min, s] = m.slice(1).map((g) => (g === undefined ? 0 : parseInt(g, 10)));
+  return d * 86400 + h * 3600 + min * 60 + s;
 };
