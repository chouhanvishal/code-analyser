 package ring
 
+import "errors"
+
 // Ring is a fixed-capacity FIFO buffer of ints.
-type Ring struct{}
+type Ring struct {
+	buf   []int
+	start int
+	n     int
+}
 
-func New(capacity int) (*Ring, error) { panic("not implemented") }
+func New(capacity int) (*Ring, error) {
+	if capacity <= 0 {
+		return nil, errors.New("capacity must be > 0")
+	}
+	return &Ring{buf: make([]int, capacity)}, nil
+}
 
-func (r *Ring) Push(v int) (evicted int, wasEvicted bool) { panic("not implemented") }
+func (r *Ring) Push(v int) (evicted int, wasEvicted bool) {
+	if r.n == len(r.buf) {
+		evicted, wasEvicted = r.buf[r.start], true
+		r.buf[r.start] = v
+		r.start = (r.start + 1) % len(r.buf)
+		return evicted, wasEvicted
+	}
+	r.buf[(r.start+r.n)%len(r.buf)] = v
+	r.n++
+	return 0, false
+}
 
-func (r *Ring) Len() int { panic("not implemented") }
+func (r *Ring) Len() int { return r.n }
 
-func (r *Ring) Items() []int { panic("not implemented") }
+func (r *Ring) Items() []int {
+	out := make([]int, r.n)
+	for i := 0; i < r.n; i++ {
+		out[i] = r.buf[(r.start+i)%len(r.buf)]
+	}
+	return out
+}
