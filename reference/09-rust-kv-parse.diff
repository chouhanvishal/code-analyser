 pub fn parse(input: &str) -> Result<Vec<(String, String)>, ParseError> {
-    let _ = input;
-    todo!()
+    let mut out = Vec::new();
+    let mut seen = HashSet::new();
+    for (idx, raw) in input.lines().enumerate() {
+        let line_no = idx + 1;
+        let line = raw.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let Some((k, v)) = line.split_once('=') else {
+            return Err(ParseError::MissingEquals(line_no));
+        };
+        let key = k.trim();
+        if key.is_empty() {
+            return Err(ParseError::EmptyKey(line_no));
+        }
+        if !seen.insert(key.to_string()) {
+            return Err(ParseError::Duplicate(key.to_string()));
+        }
+        out.push((key.to_string(), v.trim().to_string()));
+    }
+    Ok(out)
 }
